{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Charlie",
  "version": "1.0.0",
  "identifier": "com.charlie.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Charlie - Assistente Inteligente",
        "width": 1080,
        "height": 740,
        "minWidth": 850,
        "minHeight": 580,
        "center": true,
        "decorations": false
      },
      {
        "label": "spotlight",
        "title": "Charlie Spotlight",
        "width": 680,
        "height": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
