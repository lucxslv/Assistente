{
  "expo": {
    "name": "Charlie",
    "slug": "charlie-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "charlie",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para escanear o QR Code de pareamento com o seu computador."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.charlie.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.charlie.mobile"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9ba8d30-da91-4675-afdd-12cf6b59b2ba"
      }
    }
  }
}
