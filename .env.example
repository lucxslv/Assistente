# Configuração do Provedor de LLM (openai | gemini | ollama)
LLM_PROVIDER=openai

# OpenAI API Key & Modelo
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Groq (Cloud STT ultra-rápido & LLM)
GROQ_API_KEY=sua_chave_groq_aquii

# Google Gemini API Key & Modelo
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Speech-to-Text (whisper local ou groq nuvem)
STT_PROVIDER=groq
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
WHISPER_VAD_FILTER=true
WHISPER_BEAM_SIZE=5
STT_SILENCE_THRESHOLD=0.01
STT_SILENCE_DURATION=1.2
STT_MAX_DURATION=30.0

# Text-to-Speech (Edge TTS)
TTS_PROVIDER=edge
TTS_VOICE=pt-BR-FranciscaNeural

# Wake Word (Opcional)
WAKE_WORD=assistente
WAKE_WORD_ENABLED=false

# Integrações Opcionais (Home Assistant & OpenWeather)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
OPENWEATHER_API_KEY=

# Geral
ASSISTANT_NAME=Assistente
MAX_HISTORY_MESSAGES=20
LANGUAGE=pt-BR
